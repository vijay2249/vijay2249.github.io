---
import { STATUS_LABEL } from '../lib/projects';

interface Props {
  href: string;
  title: string;
  tagline: string;
  stack: string;
  status: string;
  year?: string;
  highlights?: string[];
  repo?: string;
  website?: string;
}

const {
  href,
  title,
  tagline,
  stack,
  status,
  year,
  highlights = [],
  repo,
  website,
} = Astro.props;
---

<article class="project">
  <a class="project-main" href={href}>
    <header class="project-head">
      <h3>{title}</h3>
      <span class:list={['status', `status-${status}`]}>{STATUS_LABEL[status] ?? status}</span>
    </header>
    <p class="stack">{stack}{year && ` · ${year}`}</p>
    <p class="tagline">{tagline}</p>
    {
      highlights.length > 0 && (
        <ul class="points">
          {highlights.slice(0, 3).map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
  </a>
  {
    (repo || website) && (
      <div class="links">
        {repo && (
          <a href={repo} target="_blank" rel="noopener">
            Code →
          </a>
        )}
        {website && (
          <a href={website} target="_blank" rel="noopener">
            Live →
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 100%;
    transition: transform 0.14s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .project:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: var(--shadow);
  }
  .project-main {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.5rem 1.5rem 1rem;
    color: var(--text);
    flex: 1;
  }
  .project-main:hover {
    text-decoration: none;
  }
  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .project-head h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .status {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: var(--bg-elevated);
  }
  .status-active,
  .status-shipped {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 40%, transparent);
    background: var(--brand-soft);
  }
  .status-in-progress {
    color: #ffb454;
    border-color: rgba(255, 180, 84, 0.35);
    background: rgba(255, 180, 84, 0.1);
  }
  .status-experimental {
    color: #8ea2ff;
    border-color: rgba(99, 91, 255, 0.4);
    background: rgba(99, 91, 255, 0.12);
  }
  .stack {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .points {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .links {
    display: flex;
    gap: 1.1rem;
    padding: 0.4rem 1.5rem 1.3rem;
    margin-top: auto;
  }
  .links a {
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>

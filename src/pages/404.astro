---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}${href}`;
---

<BaseLayout title="Not found" description="That page doesn't exist.">
  <section class="section">
    <div class="container center">
      <p class="eyebrow">404</p>
      <h1 class="page-title">This page wandered off.</h1>
      <p class="muted">
        The link may be broken, or the page may have been moved. Let's get you back on track.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={base}>Go home</a>
        <a class="btn btn-ghost" href={withBase('/blog')}>Browse the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .center {
    text-align: center;
    max-width: 540px;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
  }
  .actions {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/posts';

// A "now" page (nownownow.com style): what I'm focused on right now.
// Update the date and bullets whenever your focus shifts.
const updated = new Date('2026-06-26');

const learning = [
  'The QUIC protocol and HTTP/3 internals',
  'Linux internals and systems programming',
  'AWS fundamentals',
  'Data structures & algorithms in Go and Python',
];

const building = [
  'Developer-experience tooling — IDE extensions and MCP servers',
  'This blog (Astro, static, no trackers)',
  'Privacy-first open source under WeDontTrack',
];
---

<BaseLayout title="Now" description="What I'm focused on right now.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Now</p>
      <h1 class="page-title">What I'm doing now</h1>
      <p class="muted page-lead">
        A snapshot of where my attention is. Last updated {formatDate(updated)}.
      </p>

      <div class="prose">
        <h2>Learning</h2>
        <ul>
          {learning.map((x) => <li>{x}</li>)}
        </ul>

        <h2>Building</h2>
        <ul>
          {building.map((x) => <li>{x}</li>)}
        </ul>

        <h2>Off the clock</h2>
        <p>CTFs on TryHackMe, following F1 &amp; MotoGP, and a lot of music.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
  }
  .page-lead {
    margin: 0 0 2rem;
    font-size: 1.05rem;
  }
</style>

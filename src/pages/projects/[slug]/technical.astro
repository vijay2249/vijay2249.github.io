---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiagramZoom from '../../../components/DiagramZoom.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { getProjects, STATUS_LABEL } from '../../../lib/projects';
import { readingTime } from '../../../lib/posts';
import { abs, breadcrumbSchema, techArticleSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  const tech = await getCollection('projectsTech');
  const techById = new Map(tech.map((t) => [t.id, t]));

  // Other projects that also have a deep-dive, for cross-linking.
  const withTech = projects.filter((p) => techById.has(p.id));

  return withTech.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      tech: techById.get(project.id)!,
      others: withTech.filter((p) => p.id !== project.id),
    },
  }));
}

const { project, tech, others } = Astro.props;
const { data } = project;
const { Content, headings } = await render(tech);

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}${href}`;

const mins = readingTime(tech.body);
const ogImage = `/og/projects/${project.id}.png`;
const techUrl = new URL(Astro.url.pathname, Astro.site).href;
const description =
  tech.data.summary ?? `Technical implementation details for ${data.title}.`;
const schema = [
  techArticleSchema({
    title: `${data.title} — Technical deep-dive`,
    description,
    url: techUrl,
    image: abs(ogImage, Astro.site),
  }),
  breadcrumbSchema([
    { name: 'Home', url: abs('/', Astro.site) },
    { name: 'Projects', url: abs('/projects', Astro.site) },
    { name: data.title, url: abs(`/projects/${project.id}`, Astro.site) },
    { name: 'Technical deep-dive', url: techUrl },
  ]),
];
---

<BaseLayout
  title={`${data.title} — Technical deep-dive`}
  description={description}
  image={ogImage}
  imageAlt={`${data.title} — technical deep-dive`}
  schema={schema}
>
  <section class="section">
    <div class="container">
      <a class="back" href={withBase(`/projects/${project.id}`)}
        >← {data.title} overview</a
      >

      <header class="tech-header">
        <p class="eyebrow">Technical deep-dive</p>
        <h1 class="title">{data.title}</h1>
        <p class="tagline muted">{data.tagline}</p>
        <div class="meta">
          <span class="stack">{data.stack}{data.year && ` · ${data.year}`}</span>
          <span class="dot">·</span>
          <span>{mins} min read</span>
          <span class:list={['status', `status-${data.status}`]}>
            {STATUS_LABEL[data.status] ?? data.status}
          </span>
        </div>
        {
          data.tech.length > 0 && (
            <div class="techtags">
              {data.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class="layout">
        <article
          class="prose"
          data-pagefind-body
          data-pagefind-meta="category:Technical deep-dive"
        >
          <Content />
        </article>

        <aside class="sidebar">
          <TableOfContents headings={headings} />
        </aside>
      </div>

      {
        others.length > 0 && (
          <section class="more-tech">
            <h2 class="more-tech-title">Other technical deep-dives</h2>
            <ul class="more-tech-list">
              {others.map((p) => (
                <li>
                  <a href={withBase(`/projects/${p.id}/technical`)}>
                    <span class="mt-name">{p.data.title}</span>
                    <span class="mt-tagline muted">{p.data.tagline}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <p class="more">
        <a href={withBase(`/projects/${project.id}`)}>← Back to {data.title} overview</a>
      </p>
    </div>
  </section>

  <DiagramZoom />
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--brand);
    text-decoration: none;
  }
  .tech-header {
    max-width: 720px;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand);
    margin: 0 0 0.5rem;
  }
  .title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.5rem;
  }
  .tagline {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .dot {
    color: var(--text-dim);
  }
  .stack {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 240px;
    }
    .sidebar {
      order: 2;
    }
  }
  .status {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--brand);
    background: var(--brand-soft);
  }
  .techtags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .more-tech {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .more-tech-title {
    font-size: 1.3rem;
    margin: 0 0 1.25rem;
  }
  .more-tech-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .more-tech-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .more-tech-list a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
  }
  .more-tech-list a:hover {
    border-color: var(--brand);
    text-decoration: none;
  }
  .mt-name {
    font-weight: 600;
  }
  .mt-tagline {
    font-size: 0.88rem;
  }
  .more {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>

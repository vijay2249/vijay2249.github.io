---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type CategoryKey } from '../../site.config';
import { getPosts, readingTime } from '../../lib/posts';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}${href}`;

const posts = await getPosts();
const categoryKeys = Object.keys(CATEGORIES) as CategoryKey[];
---

<BaseLayout title="Blog" description="Tutorials, a developer journal, and a digital garden.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1 class="page-title">Everything I've written</h1>
      <p class="muted page-lead">
        Search by keyword or tag, or filter by the kind of post. {posts.length} posts and counting.
      </p>

      <div class="controls">
        <label class="search">
          <span class="sr-only">Search posts</span>
          <input
            type="search"
            id="post-search"
            placeholder="Search title, description, or #tag…"
            autocomplete="off"
          />
        </label>
        <div class="filters" role="group" aria-label="Filter by category">
          <button class="filter active" data-filter="all" type="button">All</button>
          {
            categoryKeys.map((key) => (
              <button class="filter" data-filter={key} type="button">
                {CATEGORIES[key].label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="grid grid-2" id="post-grid">
        {
          posts.map((post) => (
            <PostCard
              href={withBase(`/blog/${post.id}`)}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              readMins={readingTime(post.body)}
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
            />
          ))
        }
      </div>
      <p class="empty muted" id="empty-state" hidden>
        No posts match that search. Try a different keyword.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
  }
  .page-lead {
    max-width: 620px;
    margin: 0 0 2rem;
    font-size: 1.05rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  .search {
    flex: 1;
    min-width: 240px;
  }
  .search input {
    width: 100%;
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.95rem;
    font-family: var(--font);
  }
  .search input:focus {
    outline: none;
    border-color: var(--brand);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .filter:hover {
    color: var(--text);
    border-color: var(--brand);
  }
  .filter.active {
    color: var(--brand-ink);
    background: var(--brand);
    border-color: var(--brand);
  }
  .empty {
    margin-top: 2rem;
  }
</style>

<script is:inline>
  (() => {
    const search = document.getElementById('post-search');
    const grid = document.getElementById('post-grid');
    const empty = document.getElementById('empty-state');
    const filters = Array.from(document.querySelectorAll('.filter'));
    if (!search || !grid) return;
    const cards = Array.from(grid.querySelectorAll('.post'));

    let activeFilter = 'all';

    const apply = () => {
      const q = search.value.trim().toLowerCase().replace(/^#/, '');
      let visible = 0;
      for (const card of cards) {
        const matchesCat =
          activeFilter === 'all' || card.dataset.category === activeFilter;
        const haystack =
          (card.dataset.title || '') +
          ' ' +
          (card.dataset.desc || '') +
          ' ' +
          (card.dataset.tags || '');
        const matchesQuery = !q || haystack.includes(q);
        const show = matchesCat && matchesQuery;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    search.addEventListener('input', apply);
    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.dataset.filter;
        apply();
      });
    });

    // Honor ?category=... coming from the home page.
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    if (cat) {
      const target = filters.find((b) => b.dataset.filter === cat);
      if (target) target.click();
    }
  })();
</script>

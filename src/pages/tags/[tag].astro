---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, readingTime, tagCounts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = tagCounts(posts).map((t) => t.tag);
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base.replace(/\/$/, '')}${href}`;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <section class="section">
    <div class="container">
      <a class="back" href={withBase('/tags')}>← All tags</a>
      <p class="eyebrow">Tag</p>
      <h1 class="page-title">#{tag}</h1>
      <p class="muted page-lead">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with this topic.
      </p>

      <div class="grid grid-2">
        {
          posts.map((post) => (
            <PostCard
              href={withBase(`/blog/${post.id}`)}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              readMins={readingTime(post.body)}
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .back:hover {
    color: var(--brand);
    text-decoration: none;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
    color: var(--brand);
  }
  .page-lead {
    margin: 0 0 2.5rem;
    font-size: 1.05rem;
  }
</style>
